{erl_opts, [debug_info]}.

{deps, []}.

{minimum_otp_vsn, "27.0"}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{eunit_opts, [verbose]}.

{shell, [{apps, [aircraft_id]}]}.

{xref_checks, [
    undefined_function_calls,
    deprecated_function_calls
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling]}
]}.
